{
  "name": "expressowallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@emotion/react": "^11.8.2",
    "@emotion/styled": "^11.8.1",
    "@fontsource/inter": "^4.5.7",
    "@fontsource/poppins": "^4.5.5",
    "@mui/icons-material": "^5.5.1",
    "@mui/lab": "^5.0.0-alpha.73",
    "@mui/material": "^5.5.0",
    "@mui/x-date-pickers": "^5.0.20",
    "date-fns": "^2.28.0",
    "firebase": "^12.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-firebase-hooks": "^5.0.3",
    "react-helmet": "^6.1.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^5.3.0",
    "react-transition-group": "^4.4.2",
    "redux": "^4.1.2",
    "redux-devtools-extension": "^2.13.9",
    "redux-thunk": "^2.4.1",
    "workbox-background-sync": "^6.5.2",
    "workbox-broadcast-update": "^6.5.2",
    "workbox-cacheable-response": "^6.5.2",
    "workbox-core": "^6.5.2",
    "workbox-expiration": "^6.5.2",
    "workbox-google-analytics": "^6.5.2",
    "workbox-navigation-preload": "^6.5.2",
    "workbox-precaching": "^6.5.2",
    "workbox-range-requests": "^6.5.2",
    "workbox-routing": "^6.5.2",
    "workbox-strategies": "^6.5.2",
    "workbox-streams": "^6.5.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "bash scripts/with-jre.sh npx firebase emulators:exec --only firestore \"vitest run -c vitest.rules.config.ts\"",
    "prepare": "husky",
    "test:e2e": "bash e2e/run.sh",
    "test:e2e:run": "node e2e/wallet.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-helmet": "^6.1.11",
    "@types/react-redux": "^7.1.34",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-transition-group": "^4.4.12",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "firebase-tools": "^15.28.1",
    "husky": ">=9",
    "lint-staged": ">=10",
    "organize-imports-cli": "^0.9.0",
    "prettier": "^3.9.6",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "organize-imports-cli",
      "eslint --fix",
      "prettier --write"
    ]
  }
}
