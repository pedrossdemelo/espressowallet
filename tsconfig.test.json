{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,

    // Tests legitimately need Node built-ins (fs to read firestore.rules), so
    // @types/node is in scope here. That's exactly why tests are a separate
    // program: @types/node declares an ambient "constants" module which would
    // otherwise shadow this project's `constants` path alias in app code.
    "types": ["node"],

    "baseUrl": ".",
    "paths": {
      "actions": ["src/actions"],
      "actions/*": ["src/actions/*"],
      "components": ["src/components"],
      "components/*": ["src/components/*"],
      "constants": ["src/constants"],
      "constants/*": ["src/constants/*"],
      "context": ["src/context"],
      "context/*": ["src/context/*"],
      "hooks": ["src/hooks"],
      "hooks/*": ["src/hooks/*"],
      "pages": ["src/pages"],
      "pages/*": ["src/pages/*"],
      "services": ["src/services"],
      "services/*": ["src/services/*"],
      "types": ["src/types"],
      "types/*": ["src/types/*"],
      "utils": ["src/utils"],
      "utils/*": ["src/utils/*"]
    }
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/__tests__/**/*",
    "vitest.config.ts",
    "vitest.rules.config.ts"
  ]
}
